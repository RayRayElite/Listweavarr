# Optional Compose settings. Do not put service API keys here; use Settings in the app.
LISTWEAVARR_PUBLISH_IP=127.0.0.1
LISTWEAVARR_PUBLISH_PORT=8765
LISTWEAVARR_PUBLIC_URL=http://127.0.0.1:8765
LISTWEAVARR_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765

# Optional owner sign-in. Use a path INSIDE the container to a mounted password file.
LISTWEAVARR_OWNER_PASSWORD_FILE=

# Optional Plex household sign-in: numeric primary account ID (not username).
LISTWEAVARR_OWNER_PLEX_ID=
